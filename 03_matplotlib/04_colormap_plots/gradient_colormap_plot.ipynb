   "source": [
    "# Custom color map (gradient line)\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x = np.linspace(0, 10, 500)\n",
    "y = np.sin(x)\n",
    "\n",
    "plt.scatter(x, y, c=y, cmap='viridis', s=10)   # color map applied to points\n",
    "\n",
    "plt.title(\"Sine Wave with Colormap\")\n",
    "plt.colorbar(label=\"sin(x)\")\n",
    "plt.show()\n"
   ]
  }
 ],
